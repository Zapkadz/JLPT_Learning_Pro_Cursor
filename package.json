{
  "name": "kotoba-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/grammar/*.test.ts tests/kaiwa/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests *.json *.md",
    "format:check": "prettier --check src server shared tests *.json *.md",
    "backup": "tsx server/backup.ts",
    "kaiwa:gate-a-preflight": "tsx scripts/kaiwa-gate-a-preflight.mts",
    "kaiwa:capture-spike": "node scripts/kaiwa/run-capture-spike.mjs",
    "kaiwa:worker": "tsx server/workers/kaiwa/worker.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
